<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#246BFD</item>
        <item name="colorPrimaryDark">#071426</item>
        <item name="colorAccent">#57D9FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#03050B</item>
        <item name="android:statusBarColor">#03050B</item>
        <item name="android:windowBackground">#03050B</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#03050B</item>
        <item name="android:statusBarColor">#03050B</item>
        <item name="android:navigationBarColor">#03050B</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">#03050B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
