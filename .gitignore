# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
**/out/
/web/android-web-build/
/android-web-build/
/web/.android-static-work-*/
/web/public/branding/
/web/public/textures/

# production
**/build/
/android/.gradle/
/android/local.properties
/android/**/build/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/cordova.js
/android/app/src/main/assets/cordova_plugins.js
/android/.idea/
*.jks
*.keystore

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
**/.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts
